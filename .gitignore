# 环境变量（含 API Key）
.env
*.env.local
*.env.production

# 数据库文件
*.db
*.sqlite
*.sqlite3

# SQLite WAL 附属文件（T-15 起应用默认以 WAL 运行，这两个文件与 *.db 同生共死）
# 不加这条的话，只要跑过一次后端，git status 就会多出两个未跟踪文件。
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 上传文件
uploads/avatars/*
!uploads/avatars/.gitkeep

# 日志文件
*.log
logs/

# 环境覆盖文件
docker-compose.override.yml

# 根目录的 Word 文档（T-02：原作者已将其移出版本控制，此处显式忽略以保持 git status 干净）
/*.docx

# 回滚备份点（T-01）：数据库备份 / 源码归档 / 清单，均不入库
backup/
