[Unit]
Description=AI 面试系统 · 每日数据备份（interview.db + uploads + .env，保留 7 份）
Documentation=file:///opt/ai-interview-simulator/docs/03-tasks.md
# 备份要写 out 目录，必须等本地文件系统就绪；不需要网络
After=local-fs.target

[Service]
# oneshot：跑完即退出，不留常驻进程。
# 这也是"同一时刻只有一次备份在写"的第二层保障（第一层是 rotate_backup.py
# 自己的 `.rotate-backup.lock` 文件锁）。
Type=oneshot

# ⚠️ 部署时请改成实际路径（见 deploy/systemd/README.md）：
#    本项目在阿里云旧站上的真实根目录是 /root/ai-interview-simulator
WorkingDirectory=/root/ai-interview-simulator/backend
ExecStart=/root/ai-interview-simulator/backend/venv/bin/python /root/ai-interview-simulator/backend/scripts/rotate_backup.py --keep 7 --out /root/ai-interview-simulator/backup

# 以专用用户运行，最小权限。
# ⚠️ 该用户必须对 backend/ 有读权限（读 interview.db、uploads/、.env）
#    并对 backup/ 有写权限，否则备份会以退出码 2 失败 —— 见 README 的排错表。
User=interview
Group=interview

# 退出码 3 = "已有另一个实例在跑，本次跳过"。这**不是失败**，
# 不该让 systemd 把它记成 failed（否则监控会持续误告警）。
# 退出码 0 = 正常完成（含"备份成功但 .env 读不到"这一种，见脚本 docstring）。
SuccessExitStatus=0 3

# 备份是"拷贝 + 压缩"，随库与 uploads 变大而变慢。给宽松但有限的上限，
# 防止磁盘满/IO 卡死时一直占着 unit。
TimeoutStartSec=1800

# --- 加固 ---
# ⚠️ 这里**刻意不用 `ProtectSystem=strict` + `ProtectHome=true`**，理由与
#    本项目的真实部署路径有关：旧站上项目根是 `/root/ai-interview-simulator`。
#    systemd 的 `ProtectHome=true` 会让 `/root` **完全不可见**，
#    `ProtectHome=read-only` 则让它**只读**，即使配了 ReadWritePaths 也不生效——
#    结果是备份脚本连 interview.db 都读不到（打开即 ENOENT），
#    而报错只说"数据库不存在"，非常难查。
#    `ProtectSystem=full`（而非 strict）把 /usr /boot /etc 挂只读、
#    其余路径按原权限，正好够用且不会静默失效。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# 备份产物要写进这里（部署时按实际路径改；目录须由 interview 用户可写）
ReadWritePaths=/root/ai-interview-simulator/backup

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# 日志进 journal：journalctl -u backup.service
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
